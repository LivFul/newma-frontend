# Vercel variables (sprint plan §4.3). Names only — never commit values.
NEWMA_API_URL=
BFF_SERVICE_TOKEN=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_DEMO_MODE=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
# The browser reads NEXT_PUBLIC_VERCEL_ENV for the Sentry environment; Vercel sets it when the project
# option "Automatically expose System Environment Variables" is on (the default for new projects).
SENTRY_ORG=
SENTRY_PROJECT=

# Canonical public origin for metadata, sitemap and JSON-LD (name only; value set per environment).
# Falls back to VERCEL_PROJECT_PRODUCTION_URL, then to the project domain. Never VERCEL_URL.
